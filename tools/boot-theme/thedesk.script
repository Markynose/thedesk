# theDesk's boot splash (Plymouth script plugin), generated by
# thedesk-boot-theme: the mark morphing through the M3 Expressive loading
# indicator's shapes over a wavy progress bar. For a disk passphrase the bar's
# track springs into a pill with a lock badge that opens on unlock. The
# pictures are rendered from theDesk's own code; this puts them together at
# 50 frames a second.
#
# Timing follows m3/shapes/m3loadingindicator: a morph spring (297 ms) every
# 650 ms through 7 shapes, a quarter turn per finished morph, and a linear
# spin every 4666 ms. The wave drifts back toward the start, as in theDesk.
# The last frame (sky, mark, a full flat bar) is the greeter's first.

Window.SetBackgroundTopColor(@BACKGROUND@);
Window.SetBackgroundBottomColor(@BACKGROUND@);

MORPHS = 7;
STEPS = 15;          # frames per morph spring, 20 ms apart
STEP_MS = 20;
INTERVAL_MS = 650;
SPRING_MS = 297;
SPIN_MS = 4666;
FRAME_MS = 20;       # Plymouth calls refresh 50 times a second

BAR_WIDTH = 240;
WAVELENGTH = 40;
AMPLITUDE = 3;
WAVE_LEVELS = 6;     # wave-0 (flat) .. wave-6 (full amplitude)
WAVE_SPEED = 36;     # px a second
GAP = 8;             # wave end to track start: 4 px between the round caps

FIELD_WIDTH = 320;
FIELD_HEIGHT = 56;
TONES = 5;           # pill-0 (track colour) .. pill-5 (field colour)
BADGE_STEPS = 15;
MAX_BULLETS = 24;

fun mod(a, b) {
    return a - Math.Int(a / b) * b;
}

fun clamp01(value) {
    return Math.Clamp(value, 0, 1);
}

fun lerp(from, to, amount) {
    return from + (to - from) * amount;
}

# ---- Springs: Compose's tokens from m3/m3motion, as one 20 ms step each
# (generated). Each spring is an index into V (value), VEL and TARGET.
SPATIAL_FAST = 0;
SPATIAL_DEFAULT = 1;
SPATIAL_SLOW = 2;
EFFECTS_FAST = 3;
EFFECTS_DEFAULT = 4;
EFFECTS_SLOW = 5;
@SPRINGS@

V[0] = 0;
VEL[0] = 0;
TARGET[0] = 0;
KIND[0] = 0;
spring_count = 0;

fun spring(initial, token) {
    V[spring_count] = initial;
    VEL[spring_count] = 0;
    TARGET[spring_count] = initial;
    KIND[spring_count] = token;
    spring_count++;
    return spring_count - 1;
}

fun step_springs() {
    for (si = 0; si < spring_count; si++) {
        sx = V[si] - TARGET[si];
        sk = KIND[si];
        V[si] = TARGET[si] + SPRING_A[sk] * sx + SPRING_B[sk] * VEL[si];
        VEL[si] = SPRING_C[sk] * sx + SPRING_D[sk] * VEL[si];
    }
}

# snap a spring to a value, at rest
fun settle(index, value) {
    V[index] = value;
    VEL[index] = 0;
    TARGET[index] = value;
}

MARK_IN = spring(0, SPATIAL_SLOW);
D_IN = spring(0, SPATIAL_DEFAULT);
BAR_IN = spring(0, SPATIAL_SLOW);
PROGRESS = spring(0, EFFECTS_SLOW);
WAVE = spring(0, EFFECTS_SLOW);           # the wave's amplitude
MESSAGE = spring(0, EFFECTS_DEFAULT);
FIELD = spring(0, SPATIAL_DEFAULT);       # the track (0) to the pill (1)
TONE = spring(0, EFFECTS_DEFAULT);        # the bar's colours to the pill's
CONTENT = spring(0, EFFECTS_DEFAULT);     # the badge, bullets and prompt
UNLOCK = spring(0, SPATIAL_FAST);
for (i = 0; i < MAX_BULLETS; i++)
    BULLET[i] = spring(0, SPATIAL_FAST);

# ---- Pictures and sprites
for (i = 0; i < MORPHS * STEPS; i++)
    frames[i] = Image("mark-" + i + ".png");

centre_x = Window.GetX() + Window.GetWidth() / 2;
centre_y = Window.GetY() + Window.GetHeight() / 2;
mark_y = centre_y - 32;
bar_x = centre_x - BAR_WIDTH / 2;
bar_y = centre_y + 80;

mark_sprite = Sprite();
mark_sprite.SetZ(10);
d_image = Image("d.png");
d_sprite = Sprite();
d_sprite.SetZ(20);

for (i = 0; i <= WAVE_LEVELS; i++)
    waves[i] = Image("wave-" + i + ".png");
track_image = Image("track.png");
wave_sprite = Sprite();
wave_sprite.SetZ(10);
track_sprite = Sprite();
track_sprite.SetZ(5);
wave_start = Sprite(Image("wave-dot.png"));
wave_start.SetZ(11);
wave_end = Sprite(Image("wave-dot.png"));
wave_end.SetZ(11);
track_start = Sprite(Image("track-dot.png"));
track_start.SetZ(6);
track_end = Sprite(Image("track-dot.png"));
track_end.SetZ(6);
stop_dot = Sprite(Image("wave-dot.png"));
stop_dot.SetZ(7);
strip_h = waves[0].GetHeight();
dot_half = 3;

message_sprite = Sprite();
message_sprite.SetZ(30);
message_sprite.SetOpacity(0);

CAP_SIZES[0] = 8;
CAP_SIZES[1] = 16;
CAP_SIZES[2] = 32;
CAP_SIZES[3] = 64;
for (i = 0; i <= TONES; i++) {
    pill_blocks[i] = Image("pill-" + i + ".png");
    for (j = 0; j < 4; j++)
        pill_caps[i * 4 + j] = Image("pill-" + i + "-" + CAP_SIZES[j] + ".png");
}
for (i = 0; i <= BADGE_STEPS; i++)
    badges[i] = Image("badge-" + i + ".png");
lock_image = Image("lock.png");
lock_open_image = Image("lock-open.png");
bullet_image = Image("bullet.png");

pill_left = Sprite();
pill_left.SetZ(40);
pill_middle = Sprite();
pill_middle.SetZ(40);
pill_right = Sprite();
pill_right.SetZ(40);
badge_sprite = Sprite();
badge_sprite.SetZ(41);
lock_sprite = Sprite();
lock_sprite.SetZ(42);
prompt_sprite = Sprite();
prompt_sprite.SetZ(41);
for (i = 0; i < MAX_BULLETS; i++) {
    bullet_sprites[i] = Sprite();
    bullet_sprites[i].SetZ(41);
}

t = 0;
target_progress = 0;
asking = 0;          # the pill is up (until it has sprung back after Enter)
ask_ms = 0;          # when the prompt came
enter_ms = -1;       # when Enter was pressed, or -1
bullet_count = 0;

# ---- The mark
fun draw_mark(alpha) {
    tick = Math.Int(t / INTERVAL_MS);
    play = t - tick * INTERVAL_MS;
    if (play < SPRING_MS) {
        morph = mod(tick, MORPHS);
        step = Math.Int(play / STEP_MS);
        quarter = mod(tick + 1, 4);
    } else {
        morph = mod(tick + 1, MORPHS);
        step = 0;
        quarter = mod(tick + 2, 4);
    }
    # springing in: from nothing, a quarter turn behind
    mk = V[MARK_IN];
    angle = quarter * Math.Pi / 2 + mod(t, SPIN_MS) / SPIN_MS * 2 * Math.Pi - (1 - mk) * Math.Pi / 2;
    image = frames[morph * STEPS + step].Rotate(angle);
    if (Math.Abs(mk - 1) > 0.005) {
        size = Math.Max(1, image.GetWidth() * mk);
        image = image.Scale(size, size);
    }
    mark_sprite.SetImage(image);
    mark_sprite.SetX(centre_x - image.GetWidth() / 2);
    mark_sprite.SetY(mark_y - image.GetHeight() / 2);
    mark_sprite.SetOpacity(alpha);

    # the d stays upright, springing in a beat after the shape
    d = d_image;
    dk = V[D_IN];
    if (Math.Abs(dk - 1) > 0.005) {
        dw = Math.Max(1, d.GetWidth() * dk);
        d = d.Scale(dw, dw);
    }
    d_sprite.SetImage(d);
    d_sprite.SetX(centre_x - d.GetWidth() / 2);
    d_sprite.SetY(mark_y - d.GetHeight() / 2);
    d_sprite.SetOpacity(alpha);
}

# ---- The wavy bar: wave (Primary) to the progress, a gap, the track
# (SecondaryContainer) and the stop dot; it draws out from its middle
fun draw_bar(alpha) {
    half = BAR_WIDTH / 2 * clamp01(V[BAR_IN]);
    left = centre_x - half;
    right = centre_x + half;
    active = Math.Int(2 * half * clamp01(V[PROGRESS]) * 2 * half / BAR_WIDTH);
    level = Math.Clamp(Math.Int(V[WAVE] / AMPLITUDE * WAVE_LEVELS + 0.5), 0, WAVE_LEVELS);
    amplitude = AMPLITUDE * level / WAVE_LEVELS;
    offset = mod(t / 1000 * WAVE_SPEED, WAVELENGTH) + (left - bar_x);
    wave_alpha = 0;
    if (active >= 1 && alpha > 0) {
        wave_sprite.SetImage(waves[level].Crop(offset, 0, active, strip_h));
        wave_sprite.SetX(left);
        wave_sprite.SetY(bar_y - strip_h / 2);
        wave_start.SetX(left - dot_half);
        wave_start.SetY(bar_y + amplitude * Math.Sin(2 * Math.Pi * offset / WAVELENGTH) - dot_half);
        wave_end.SetX(left + active - dot_half);
        wave_end.SetY(bar_y + amplitude * Math.Sin(2 * Math.Pi * (offset + active) / WAVELENGTH) - dot_half);
        wave_alpha = alpha;
    }
    wave_sprite.SetOpacity(wave_alpha);
    wave_start.SetOpacity(wave_alpha);
    wave_end.SetOpacity(wave_alpha);

    track_from = left;
    if (active > 1)
        track_from = left + active + GAP;
    track_alpha = 0;
    if (track_from < right - 1 && alpha > 0) {
        track_sprite.SetImage(track_image.Crop(0, 0, Math.Int(right - track_from), strip_h));
        track_sprite.SetX(track_from);
        track_sprite.SetY(bar_y - strip_h / 2);
        track_start.SetPosition(track_from - dot_half, bar_y - dot_half, 6);
        track_end.SetPosition(right - dot_half, bar_y - dot_half, 6);
        stop_dot.SetPosition(right - 2 - dot_half, bar_y - dot_half, 7);
        track_alpha = alpha;
    }
    track_sprite.SetOpacity(track_alpha);
    track_start.SetOpacity(track_alpha);
    track_end.SetOpacity(track_alpha);
    stop_dot.SetOpacity(track_alpha);
}

# ---- The passphrase pill: grows out of the track, with the lock badge,
# the bullets inside and the prompt under it
fun hide_field() {
    pill_left.SetOpacity(0);
    pill_middle.SetOpacity(0);
    pill_right.SetOpacity(0);
    badge_sprite.SetOpacity(0);
    lock_sprite.SetOpacity(0);
    prompt_sprite.SetOpacity(0);
    for (bi = 0; bi < MAX_BULLETS; bi++)
        bullet_sprites[bi].SetOpacity(0);
}

fun draw_field(alpha) {
    grow = V[FIELD];
    if (grow < 0.004 && V[TONE] < 0.004) {
        hide_field();
        return;
    }
    # two round ends and a block between, so the ends stay round as it grows
    half_h = Math.Max(1, Math.Int(Math.Max(2, lerp(4, FIELD_HEIGHT, grow)) / 2 + 0.5));
    width = Math.Max(2 * half_h + 1, Math.Int(lerp(BAR_WIDTH, FIELD_WIDTH, grow) + 0.5));
    x0 = Math.Int(centre_x - width / 2);
    tone = Math.Int(clamp01(V[TONE]) * TONES + 0.5);
    cap_index = 0;
    while (cap_index < 3 && CAP_SIZES[cap_index] < 2 * half_h)
        cap_index++;
    cap = pill_caps[tone * 4 + cap_index].Scale(2 * half_h, 2 * half_h);
    pill_left.SetImage(cap.Crop(0, 0, half_h, 2 * half_h));
    pill_left.SetPosition(x0, bar_y - half_h, 40);
    pill_right.SetImage(cap.Crop(half_h, 0, half_h, 2 * half_h));
    pill_right.SetPosition(x0 + width - half_h, bar_y - half_h, 40);
    pill_middle.SetImage(pill_blocks[tone].Scale(width - 2 * half_h, 2 * half_h));
    pill_middle.SetPosition(x0 + half_h, bar_y - half_h, 40);
    pill_alpha = alpha * clamp01(grow * 6);
    pill_left.SetOpacity(pill_alpha);
    pill_middle.SetOpacity(pill_alpha);
    pill_right.SetOpacity(pill_alpha);

    content = alpha * clamp01(V[CONTENT]);
    # the badge: Cookie4Sided turning into a Primary circle as the lock opens
    unlock = V[UNLOCK];
    badge = badges[Math.Int(clamp01(unlock) * BADGE_STEPS + 0.5)].Rotate(unlock * Math.Pi / 4);
    badge_sprite.SetImage(badge);
    badge_sprite.SetPosition(x0 + 28 - badge.GetWidth() / 2, bar_y - badge.GetHeight() / 2, 41);
    badge_sprite.SetOpacity(content);
    lock = lock_image;
    if (unlock > 0.5)
        lock = lock_open_image;
    lock_sprite.SetImage(lock);
    lock_sprite.SetPosition(x0 + 28 - lock.GetWidth() / 2, bar_y - lock.GetHeight() / 2, 42);
    lock_sprite.SetOpacity(content);

    # the bullets pop in, squeezing up past 11
    spacing = 22;
    if (bullet_count > 11)
        spacing = (FIELD_WIDTH - 66 - 24) / (bullet_count - 1);
    for (bi = 0; bi < MAX_BULLETS; bi++) {
        bk = V[BULLET[bi]];
        if (bk > 0.01 && content > 0) {
            bullet = bullet_image;
            if (Math.Abs(bk - 1) > 0.005) {
                bw = Math.Max(1, bullet.GetWidth() * bk);
                bullet = bullet.Scale(bw, bw);
            }
            bullet_sprites[bi].SetImage(bullet);
            bullet_sprites[bi].SetPosition(x0 + 66 + bi * spacing - bullet.GetWidth() / 2, bar_y - bullet.GetHeight() / 2, 41);
            bullet_sprites[bi].SetOpacity(content);
        } else {
            bullet_sprites[bi].SetOpacity(0);
        }
    }

    prompt = prompt_sprite.GetImage();
    if (prompt) {
        prompt_sprite.SetX(centre_x - prompt.GetWidth() / 2);
        prompt_sprite.SetY(bar_y + half_h + 12 + (22 - prompt.GetHeight()) / 2 - (1 - clamp01(V[CONTENT])) * 8);
    }
    prompt_sprite.SetOpacity(content);
}

# The passphrase beat after Enter: the lock opens (220 ms), the bullets
# shrink one after another, and the pill springs back into the bar (550 ms)
fun update_field() {
    if (enter_ms >= 0 && t >= enter_ms + 550) {
        asking = 0;
        enter_ms = -1;
    }
    entered = enter_ms >= 0;
    TARGET[FIELD] = asking;
    TARGET[TONE] = asking;
    TARGET[CONTENT] = 0;
    if (asking && t >= ask_ms + 120 && !(entered && t >= enter_ms + 470))
        TARGET[CONTENT] = 1;
    TARGET[UNLOCK] = 0;
    if (entered && t >= enter_ms + 220)
        TARGET[UNLOCK] = 1;
    for (bi = 0; bi < MAX_BULLETS; bi++) {
        TARGET[BULLET[bi]] = 0;
        if (bi < bullet_count && !(entered && t >= enter_ms + 220 + 30 * bi))
            TARGET[BULLET[bi]] = 1;
    }
}

fun refresh() {
    t += FRAME_MS;
    if (t >= 120) TARGET[MARK_IN] = 1;
    if (t >= 260) TARGET[D_IN] = 1;
    if (t >= 360) TARGET[BAR_IN] = 1;
    TARGET[PROGRESS] = target_progress;
    # Compose's amplitude rule: flat at 10 % or less and at 95 % or more
    TARGET[WAVE] = AMPLITUDE;
    if (V[PROGRESS] <= 0.1 || V[PROGRESS] >= 0.95)
        TARGET[WAVE] = 0;
    update_field();
    step_springs();
    fade = Math.Min(t / 250, 1); # (the springs do the entrance; this just softens the first frames)
    draw_mark(fade);
    draw_bar(fade * (1 - clamp01(V[TONE])));
    draw_field(fade);
    message_sprite.SetOpacity(fade * clamp01(V[MESSAGE]));
}
Plymouth.SetRefreshFunction(refresh);

fun boot_progress(duration, progress) {
    if (progress > target_progress)
        target_progress = Math.Min(progress, 1);
}
Plymouth.SetBootProgressFunction(boot_progress);

# Messages (fsck and the like) under the bar
fun show_message(text) {
    image = Image.Text(text, @ON_SURFACE_VARIANT@);
    message_sprite.SetImage(image);
    message_sprite.SetPosition(centre_x - image.GetWidth() / 2, bar_y + 40 - image.GetHeight() / 2, 30);
    TARGET[MESSAGE] = 1;
}
Plymouth.SetDisplayMessageFunction(show_message);

fun hide_message(text) {
    TARGET[MESSAGE] = 0;
}
Plymouth.SetHideMessageFunction(hide_message);

# Disk encryption: the bar's track springs into the pill
fun display_password(prompt_text, count) {
    if (!asking) {
        ask_ms = t;
        settle(UNLOCK, 0);
        for (bi = 0; bi < MAX_BULLETS; bi++)
            settle(BULLET[bi], 0);
    }
    # (asked again during the unlock: the passphrase was wrong, so the lock closes)
    asking = 1;
    enter_ms = -1;
    bullet_count = Math.Min(count, MAX_BULLETS);
    prompt_sprite.SetImage(Image.Text(prompt_text, @ON_SURFACE_VARIANT@));
}
Plymouth.SetDisplayPasswordFunction(display_password);

# Enter (Plymouth hands the passphrase on): squash the pill, then unlock
fun display_normal() {
    if (asking && enter_ms < 0) {
        enter_ms = t;
        VEL[FIELD] = VEL[FIELD] - 3.2;
    }
}
Plymouth.SetDisplayNormalFunction(display_normal);

# The hand-out: the greeter starts from the mark over a full, flat bar
fun quit() {
    target_progress = 1;
    settle(PROGRESS, 1);
    settle(WAVE, 0);
    settle(MARK_IN, 1);
    settle(D_IN, 1);
    settle(BAR_IN, 1);
    settle(MESSAGE, 0);
    asking = 0;
    enter_ms = -1;
    settle(FIELD, 0);
    settle(TONE, 0);
    settle(CONTENT, 0);
    if (t < 250) t = 250;
    refresh();
}
Plymouth.SetQuitFunction(quit);
