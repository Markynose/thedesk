# theDesk's boot splash (Plymouth script plugin), generated by
# thedesk-boot-theme: the mark morphing through the M3 Expressive loading
# indicator's shapes over a wavy progress bar. The pictures are rendered from
# theDesk's own code; this puts them together at 50 frames a second.
#
# Timing follows m3/shapes/m3loadingindicator: a morph spring (297 ms) every
# 650 ms through 7 shapes, a quarter turn per finished morph, and a linear
# spin every 4666 ms. The wave drifts back toward the start, as in theDesk.

Window.SetBackgroundTopColor(@BACKGROUND@);
Window.SetBackgroundBottomColor(@BACKGROUND@);

MORPHS = 7;
STEPS = 15;          # frames per morph spring, 20 ms apart
STEP_MS = 20;
INTERVAL_MS = 650;
SPRING_MS = 297;
SPIN_MS = 4666;
FRAME_MS = 20;       # Plymouth calls refresh 50 times a second

BAR_WIDTH = 240;
WAVELENGTH = 40;
AMPLITUDE = 3;
WAVE_SPEED = 36;     # px a second
GAP = 6;

fun mod(a, b) {
    return a - Math.Int(a / b) * b;
}

# The entrance: an expressive spring, one value every 20 ms (generated)
@ENTRANCE@
ENTRANCE_N = 60;

fun entrance(ms) {
    i = Math.Int(ms / FRAME_MS);
    if (i < 0) return 0;
    if (i >= ENTRANCE_N) return 1;
    return ENTRANCE[i];
}

for (i = 0; i < MORPHS * STEPS; i++)
    frames[i] = Image("mark-" + i + ".png");

centre_x = Window.GetX() + Window.GetWidth() / 2;
centre_y = Window.GetY() + Window.GetHeight() / 2;
mark_y = centre_y - 32;
bar_x = centre_x - BAR_WIDTH / 2;
bar_y = centre_y + 80;

mark_sprite = Sprite();
mark_sprite.SetZ(10);
d_image = Image("d.png");
d_sprite = Sprite();
d_sprite.SetZ(20);

# The wave, and flatter ones for when boot is about done
waves[0] = Image("wave.png");
for (i = 1; i < 4; i++)
    waves[i] = Image("wave-" + i + ".png");
wave_image = waves[0];
track_image = Image("track.png");
wave_sprite = Sprite();
wave_sprite.SetZ(10);
track_sprite = Sprite();
track_sprite.SetZ(5);
wave_start = Sprite(Image("wave-dot.png"));
wave_start.SetZ(11);
wave_end = Sprite(Image("wave-dot.png"));
wave_end.SetZ(11);
track_start = Sprite(Image("track-dot.png"));
track_start.SetZ(6);
strip_h = wave_image.GetHeight();
dot_half = 3;

message_sprite = Sprite();
message_sprite.SetZ(30);

t = 0;
target_progress = 0;
shown_progress = 0;
asking = 0;

fun set_opacity(o) {
    mark_sprite.SetOpacity(o);
    d_sprite.SetOpacity(o);
    wave_sprite.SetOpacity(o);
    track_sprite.SetOpacity(o);
    wave_start.SetOpacity(o);
    wave_end.SetOpacity(o);
    track_start.SetOpacity(o);
}

fun draw_mark() {
    tick = Math.Int(t / INTERVAL_MS);
    play = t - tick * INTERVAL_MS;
    if (play < SPRING_MS) {
        morph = mod(tick, MORPHS);
        step = Math.Int(play / STEP_MS);
        quarter = mod(tick + 1, 4);
    } else {
        morph = mod(tick + 1, MORPHS);
        step = 0;
        quarter = mod(tick + 2, 4);
    }
    # springing in: from nothing, a quarter turn behind
    k = entrance(t - 60);
    angle = quarter * Math.Pi / 2 + mod(t, SPIN_MS) / SPIN_MS * 2 * Math.Pi - (1 - k) * Math.Pi / 2;
    image = frames[morph * STEPS + step].Rotate(angle);
    if (k < 0.995) {
        size = Math.Max(1, image.GetWidth() * k);
        image = image.Scale(size, size);
    }
    mark_sprite.SetImage(image);
    mark_sprite.SetX(centre_x - image.GetWidth() / 2);
    mark_sprite.SetY(mark_y - image.GetHeight() / 2);

    # the d stays upright, springing in a beat after the shape
    d = d_image;
    dk = entrance(t - 160);
    if (dk < 0.995) {
        dw = Math.Max(1, d.GetWidth() * dk);
        d = d.Scale(dw, dw);
    }
    d_sprite.SetImage(d);
    d_sprite.SetX(centre_x - d.GetWidth() / 2);
    d_sprite.SetY(mark_y - d.GetHeight() / 2);
}

fun draw_bar() {
    # Ease toward Plymouth's estimate so the bar never jumps or goes back
    shown_progress = shown_progress + (target_progress - shown_progress) * 0.06;
    # the waves iron flat as boot gets done
    level = 0;
    if (shown_progress > 0.92)
        level = Math.Min(3, Math.Int((shown_progress - 0.92) / 0.08 * 4));
    wave_image = waves[level];
    # the bar draws out from its middle as it comes in
    half = BAR_WIDTH / 2 * entrance(t - 220);
    bar_left = BAR_WIDTH / 2 - half;
    bar_right = BAR_WIDTH / 2 + half;
    active = Math.Min(Math.Int(BAR_WIDTH * shown_progress), Math.Int(bar_right));
    offset = mod(t / 1000 * WAVE_SPEED, WAVELENGTH);
    if (active >= 2) {
        wave_sprite.SetImage(wave_image.Crop(offset, 0, active, strip_h));
        wave_sprite.SetX(bar_x);
        wave_sprite.SetY(bar_y - strip_h / 2);
        wave_start.SetX(bar_x - dot_half);
        wave_start.SetY(bar_y + AMPLITUDE * Math.Sin(2 * Math.Pi * offset / WAVELENGTH) - dot_half);
        wave_end.SetX(bar_x + active - dot_half);
        wave_end.SetY(bar_y + AMPLITUDE * Math.Sin(2 * Math.Pi * (offset + active) / WAVELENGTH) - dot_half);
        wave_on = 1;
    } else {
        wave_on = 0;
    }
    track_from = Math.Max(active + GAP + 2, Math.Int(bar_left));
    track_to = Math.Min(track_image.GetWidth(), Math.Int(bar_right) + 4);
    if (track_from < bar_right - 2) {
        track_sprite.SetImage(track_image.Crop(track_from, 0, track_to - track_from, strip_h));
        track_sprite.SetX(bar_x + track_from);
        track_sprite.SetY(bar_y - strip_h / 2);
        track_start.SetX(bar_x + track_from - dot_half);
        track_start.SetY(bar_y - dot_half);
        track_on = 1;
    } else {
        track_on = 0;
    }
    return wave_on * 2 + track_on;
}

fun refresh() {
    t += FRAME_MS;
    fade = Math.Min(t / 250, 1); # (the springs do the entrance; this just softens the first frames)
    draw_mark();
    visible = draw_bar();
    set_opacity(fade);
    if (asking || Math.Int(visible / 2) == 0) {
        wave_sprite.SetOpacity(0);
        wave_start.SetOpacity(0);
        wave_end.SetOpacity(0);
    }
    if (asking || mod(visible, 2) == 0) {
        track_sprite.SetOpacity(0);
        track_start.SetOpacity(0);
    }
}
Plymouth.SetRefreshFunction(refresh);

fun boot_progress(duration, progress) {
    if (progress > target_progress)
        target_progress = Math.Min(progress, 1);
}
Plymouth.SetBootProgressFunction(boot_progress);

# Messages (fsck and the like) under the bar
fun show_message(text) {
    image = Image.Text(text, @ON_SURFACE_VARIANT@);
    message_sprite.SetImage(image);
    message_sprite.SetPosition(centre_x - image.GetWidth() / 2, bar_y + 40, 30);
}
Plymouth.SetMessageFunction(show_message);

# Disk encryption: the bar becomes a password field
field_sprite = Sprite();
field_sprite.SetZ(40);
prompt_sprite = Sprite();
prompt_sprite.SetZ(41);
bullets_sprite = Sprite();
bullets_sprite.SetZ(41);

fun display_password(prompt, bullets) {
    asking = 1;
    field = Image("field.png");
    field_sprite.SetImage(field);
    field_sprite.SetPosition(centre_x - field.GetWidth() / 2, bar_y - field.GetHeight() / 2, 40);
    field_sprite.SetOpacity(1);
    p = Image.Text(prompt, @ON_SURFACE_VARIANT@);
    prompt_sprite.SetImage(p);
    prompt_sprite.SetPosition(centre_x - p.GetWidth() / 2, bar_y - field.GetHeight() / 2 - p.GetHeight() - 12, 41);
    prompt_sprite.SetOpacity(1);
    text = "";
    for (i = 0; i < bullets && i < 24; i++)
        text = text + "•";
    b = Image.Text(text, @ON_SURFACE@);
    bullets_sprite.SetImage(b);
    bullets_sprite.SetPosition(centre_x - field.GetWidth() / 2 + 24, bar_y - b.GetHeight() / 2, 41);
    bullets_sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password);

fun display_normal() {
    asking = 0;
    field_sprite.SetOpacity(0);
    prompt_sprite.SetOpacity(0);
    bullets_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal);
